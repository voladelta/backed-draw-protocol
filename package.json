    "wagmi": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
